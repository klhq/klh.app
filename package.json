  },
  "private": true,
  "scripts": {
    "dev": "bun run fetch:content && next dev",
    "dev:local": "next dev",
    "dev:clean": "bun run clean && bun run dev",
    "fetch:content": "bun scripts/fetch-content.ts",
    "fetch:content:strict": "bun scripts/fetch-content.ts --strict",
    "build": "bun run fetch:content:strict && next build",
    "clean": "rm -rf .next",
    "start": "next start",
    "lint": "eslint src",
    "prettier": "prettier --write src"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
