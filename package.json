    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.31.0",
    "next": "^16.2.2",
    "next-intl": "^4.9.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.18.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
